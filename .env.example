# Copy this file to .env and fill in your own values, then
# `docker compose up -d --build`. .env is gitignored - never commit real secrets.

# Host port to expose the app on, e.g. http://<host>:8080. Leave unset for 8000.
WEB_PORT=8000

# A private GitHub repo dedicated to database backups, e.g. "yourname/injection-db-backup"
GITHUB_BACKUP_REPO=

# A GitHub personal access token with write access to just that one repo
# (fine-grained PAT scoped to this single repo is recommended).
GITHUB_BACKUP_TOKEN=

# Branch to push backups to (must already exist in the repo, e.g. from its initial commit).
GITHUB_BACKUP_BRANCH=main
